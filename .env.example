# Port to listen on (Render sets this automatically)
PORT=3000

# Optional shared secret. When set, requests to /mcp need "Authorization: Bearer <token>" or "?token=<token>".
MCP_AUTH_TOKEN=

# Upstream cache. MOFA refreshes data about every 5 minutes.
CACHE_TTL_SECONDS=300
# Each cached country file uses ~10 MB of heap; keep this low on small instances.
CACHE_MAX_ENTRIES=20

# Upstream request timeout
FETCH_TIMEOUT_MS=30000

# Set to "stdio" to run over stdio instead of HTTP (same as passing --stdio)
# MCP_TRANSPORT=stdio
